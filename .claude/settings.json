{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(python3 --version)",
      "Bash(python3 -m py_compile *)",
      "Bash(php --version)",
      "Bash(php -l *)",
      "Bash(psql --version)",
      "Bash(psql -U postgres -d venom -c \"SELECT*\")",
      "Bash(ruff check code/)",
      "Bash(ruff check code/* --output-format=concise)",
      "Bash(node --check *)",
      "Bash(mkdir -p *)",
      "Read(*)"
    ],
    "deny": [
      "Bash(sudo python3 code/venom_route.py*)",
      "Bash(sudo iptables*)",
      "Bash(sudo arping*)",
      "Bash(sudo scapy*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(DROP TABLE*)",
      "Bash(DELETE FROM*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=\"$CLAUDE_TOOL_INPUT_FILE_PATH\"; ext=\"${file##*.}\"; if [ \"$ext\" = \"php\" ]; then php -l \"$file\" 2>&1 | grep -v 'No syntax errors'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[Venom] Archivo editado: $CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      }
    ]
  }
}
